apiVersion: v1
kind: Config
clusters:
  - name: {{ kubeconfig_cluster }}
    cluster:
      certificate-authority-data: {{ kubeconfig_ca_b64 }}
      server: {{ kubeconfig_server }}
contexts:
  - name: {{ kubeconfig_user }}@{{ kubeconfig_cluster }}
    context:
      cluster: {{ kubeconfig_cluster }}
      user: {{ kubeconfig_user }}
current-context: {{ kubeconfig_user }}@{{ kubeconfig_cluster }}
preferences: {}
users:
  - name: {{ kubeconfig_user }}
    user:
      client-certificate-data: {{ kubeconfig_cert_b64 }}
      client-key-data: {{ kubeconfig_key_b64 }}
