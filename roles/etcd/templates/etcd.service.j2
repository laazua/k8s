[Unit]
Description=etcd member {{ etcd_member_name }}
Documentation=https://etcd.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type={{ etcd_service_type }}
User={{ etcd_user }}
Group={{ etcd_user_group }}
{% if etcd_tls_enabled | bool %}
# 私钥 root:{{ etcd_cert_group }} {{ etcd_cert_key_mode }}：主组/补充组即可读，且服务用户不能改写
SupplementaryGroups={{ etcd_cert_group }}
{% endif %}
ExecStart={{ etcd_bin_dir }}/etcd {{ etcd_exec_args | join(' ') }}
Restart=always
RestartSec={{ etcd_restart_sec }}
LimitNOFILE={{ etcd_limit_nofile }}
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
