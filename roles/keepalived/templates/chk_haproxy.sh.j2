#!/bin/sh
# {{ ansible_managed | default('Ansible managed: roles/keepalived') }}
# 0 = 本机 haproxy 存活；非 0 = 让 keepalived 进入 FAULT（不持有 VIP）。
# 使用 pid 文件而不是 pidof：同机多 netns/容器时 pidof 会看到别处的进程。
PID_FILE="{{ keepalived_haproxy_pid_file }}"

[ -r "$PID_FILE" ] || exit 1
PID="$(cat "$PID_FILE" 2>/dev/null)" || exit 1
[ -n "$PID" ] || exit 1
kill -0 "$PID" 2>/dev/null || exit 1
exit 0
