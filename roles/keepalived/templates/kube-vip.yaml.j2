# {{ ansible_managed | default('Ansible managed: roles/keepalived') }}
# ha_mode=kube-vip：静态 Pod 清单（仅配置渲染；真实漂移/选主未验证，见契约 §5）
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  hostNetwork: true
  containers:
    - name: kube-vip
      image: {{ kube_vip_image }}
      env:
        - name: vip_arp
          value: "true"
        - name: port
          value: "{{ k8s_apiserver_port | default(6443) }}"
        - name: vip_interface
          value: "{{ keepalived_interface }}"
        - name: vip_cidr
          value: "{{ keepalived_vip_prefix }}"
        - name: cp_enable
          value: "{{ kube_vip_cp_enable | lower }}"
        - name: vip_leaderelection
          value: "{{ kube_vip_leaderelection | lower }}"
        - name: vip_address
          value: "{{ keepalived_vip }}"
