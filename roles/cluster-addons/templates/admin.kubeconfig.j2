apiVersion: v1
kind: Config
clusters:
  - name: {{ cluster_addons_cluster_name }}
    cluster:
      certificate-authority-data: {{ addons_ca_b64 }}
      server: {{ cluster_addons_server }}
users:
  - name: {{ cluster_addons_admin_user }}
    user:
      client-certificate-data: {{ addons_admin_cert_b64 }}
      client-key-data: {{ addons_admin_key_b64 }}
contexts:
  - name: {{ cluster_addons_admin_user }}@{{ cluster_addons_cluster_name }}
    context:
      cluster: {{ cluster_addons_cluster_name }}
      user: {{ cluster_addons_admin_user }}
current-context: {{ cluster_addons_admin_user }}@{{ cluster_addons_cluster_name }}
preferences: {}
